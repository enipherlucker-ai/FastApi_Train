POSTGRES_SETTINGS__HOST=your_database
POSTGRES_SETTINGS__USER=admin_name
POSTGRES_SETTINGS__PASSWORD=secret_pass
POSTGRES_SETTINGS__DATABASE=pg_test_db

CHECK_RECEIPT_SETTINGS__URL=url
CHECK_RECEIPT_SETTINGS__TOKEN=your_token

OPEN_AI_SETTINGS__API_KEY=your_open_ai_key

TELEGRAM_SETTINGS__TOKEN=your_token
TELEGRAM_SETTINGS__ALLOWED_USER_IDS=[your_chat_id]
RECEIPT_API_SETTINGS__URL=http://127.0.0.1:8000
# Прокси для Telegram, если без него api.telegram.org не открывается.
# Локально (python -m bot.main) прокси берётся из системы, эту строку можно не писать.
# TELEGRAM_SETTINGS__PROXY=http://127.0.0.1:port
# В Docker системного прокси нет: адрес компьютера изнутри контейнера — host.docker.internal.
# TELEGRAM_DOCKER_PROXY=http://host.docker.internal:port
